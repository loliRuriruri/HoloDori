{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoloDori Live2D Manager",
  "version": "0.1.0",
  "identifier": "com.holodori.live2dmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HoloDori Live2D Manager",
        "width": 1100,
        "height": 780,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
